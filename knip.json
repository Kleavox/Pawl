{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["wasm-pack"],
  "workspaces": {
    "packages/ui": {
      "ignore": ["scripts/page-css.d.mts"]
    },
    "apps/pass": {
      "entry": [
        "index.html",
        "src/entry.tsx",
        "src/prerender.tsx",
        "vite.config.ts"
      ],
      "vite": false
    },
    "apps/web": {
      "entry": [
        "index.html",
        "privacy.html",
        "terms.html",
        "src/cabinet-entry.tsx",
        "src/receipt-entry.tsx",
        "src/prerender.tsx",
        "vite.config.ts"
      ],
      "vite": false
    },
    "packages/crypto": {
      "ignoreUnresolved": ["../pkg/crypto.js"]
    },
    "packages/oidc": {
      "ignoreUnresolved": ["../pkg/oidc.js"]
    },
    "packages/registry": {
      "ignoreUnresolved": ["../pkg/registry.js"]
    },
    "tooling/e2e": {
      "entry": [
        "playwright.config.ts",
        "prepare.mjs",
        "tests/**/*.ts",
        "fixture/worker.ts"
      ],
      "playwright": false
    },
    "worker": {
      "ignoreDependencies": ["@pawl/pass-app", "@pawl/web-app"]
    }
  }
}
