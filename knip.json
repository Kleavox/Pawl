{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["wasm-pack"],
  "workspaces": {
    "apps/web": {
      "entry": [
        "index.html",
        "privacy.html",
        "terms.html",
        "src/legal.ts",
        "src/main.ts",
        "vite.config.ts"
      ],
      "vite": false
    },
    "packages/core": {
      "ignore": ["scripts/machine-css.d.mts"]
    },
    "packages/crypto": {
      "ignoreUnresolved": ["../pkg/crypto.js"]
    },
    "packages/oidc": {
      "ignoreUnresolved": ["../pkg/oidc.js"]
    },
    "packages/registry": {
      "ignoreUnresolved": ["../pkg/registry.js"]
    },
    "tooling/e2e": {
      "entry": [
        "playwright.config.ts",
        "prepare.mjs",
        "tests/**/*.ts",
        "fixture/worker.ts"
      ],
      "playwright": false
    },
    "worker": {
      "ignoreDependencies": ["@pawl/pass-app", "@pawl/web-app"]
    }
  }
}
