{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "Cargo.lock",
    "Cargo.toml",
    "tsconfig.base.json",
    "tooling/typescript/*.json",
    "estate.json"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["VITE_*", "PUBLIC_*", "ESTATE_MANIFEST"],
      "outputs": ["dist/**", "pkg/**"]
    },
    "@pawl/crypto#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../crates/crypto/src/**",
        "../../crates/crypto/Cargo.toml",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "outputs": ["dist/**", "pkg/**"]
    },
    "@pawl/oidc#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../crates/oidc/src/**",
        "../../crates/oidc/Cargo.toml",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "outputs": ["dist/**", "pkg/**"]
    },
    "@pawl/worker#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../crates/cli/src/**",
        "../crates/cli/Cargo.toml"
      ],
      "outputs": ["dist/**", "assets/**"]
    },
    "@pawl/oidc#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@pawl/oidc#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@pawl/registry#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../crates/registry/src/**",
        "../../crates/registry/Cargo.toml",
        "../../Cargo.toml",
        "../../Cargo.lock"
      ],
      "outputs": ["dist/**", "pkg/**"]
    },
    "@pawl/registry#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@pawl/registry#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
